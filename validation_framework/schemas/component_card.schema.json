{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Statera-Guild/edge-gpu-computer-catalog/blob/main/validation_framework/schemas/component_card.schema.json",
  "title": "EdgeGPUComputerCard",
  "type": "object",
  "required": [
    "component_id",
    "guild",
    "class",
    "manufacturer",
    "product_name",
    "exact_part_number",
    "record_scope",
    "status",
    "source_urls",
    "last_reviewed"
  ],
  "properties": {
    "component_id": {
      "type": "string",
      "pattern": "^CMP-EGC-[0-9]{4}$"
    },
    "guild": {
      "const": "CMP"
    },
    "class": {
      "const": "EGC"
    },
    "manufacturer": {
      "type": "string",
      "minLength": 1
    },
    "product_name": {
      "type": "string",
      "minLength": 1
    },
    "exact_part_number": {
      "type": "string"
    },
    "record_scope": {
      "enum": [
        "family",
        "configuration"
      ]
    },
    "status": {
      "enum": [
        "listed",
        "documented"
      ]
    },
    "source_urls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "uses_module_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "card_path": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
